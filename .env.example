# Backend
CAMERA_URL=rtsp://<camera-ip>:<port>/h264_ulaw.sdp
CAMERA_ZONE=Library - Block B
PORT=5000
FRONTEND_URL=http://localhost:5173
DEBUG=false
OMNI_EMBEDDING_ENCRYPTION_KEY=replace-with-long-random-secret
OMNI_PAYLOAD_SIGNING_SECRET=replace-with-long-random-secret
OMNI_REQUIRE_SIGNED_DETECTIONS=true
OMNI_REQUIRE_SIGNED_SOCKET_DETECTIONS=true
OMNI_SIGNATURE_MAX_AGE_MS=15000
OMNI_ALLOW_HEADER_ROLE=true
OMNI_RBAC_KEYS_JSON={"admin":"change-admin-key","operator":"change-operator-key","viewer":"change-viewer-key"}
RECOGNITION_HIGH_RISK_CAMERAS=main-gate,entry-lane
RECOGNITION_LIVENESS_MIN_SCORE=0.45
RECOGNITION_LIVENESS_REQUIRED_SAMPLES=3
RECOGNITION_MATCH_TIMEOUT_MS=1200
RECOGNITION_STABILITY_BUFFER_SIZE=12
RECOGNITION_STABILITY_CONSECUTIVE_MIN=3
RECOGNITION_STABILITY_CONFIRM_THRESHOLD=0.75
RECOGNITION_STABILITY_LOCK_MS=1500
RECOGNITION_STABILITY_SWITCH_DELTA=0.1
RECOGNITION_STABILITY_ADAPTIVE_LATENCY_MS=650
RECOGNITION_STABILITY_ADAPTIVE_THRESHOLD_BOOST=0.04
RECOGNITION_STABILITY_CONFIDENCE_DECAY=0.97
RECOGNITION_STABILITY_CONFIDENCE_MIN=0.25
RECOGNITION_STABILITY_PREDICTION_BOOST=0.07
RECOGNITION_STABILITY_PREDICTION_MISMATCH_PENALTY=0.06
RECOGNITION_STABILITY_SWITCH_PERSIST_FRAMES=2
RECOGNITION_STABILITY_MOTION_SMALL_SHIFT_PX=36
RECOGNITION_STABILITY_MOTION_LARGE_SHIFT_PX=92
RECOGNITION_STABILITY_MOTION_BOOST=0.04
RECOGNITION_STABILITY_MOTION_JUMP_PENALTY=0.08
RECOGNITION_STABILITY_SMOOTHING_ALPHA=0.3
RECOGNITION_STABILITY_PERF_TARGET_MS=5
RECOGNITION_STABILITY_NO_DETECTION_GRACE_MS=1500
RECOGNITION_STABILITY_DEBUG=false
OMNI_RECENT_METRICS_SIZE=100
OMNI_ALERT_BUFFER_SIZE=120
OMNI_IN_MEMORY_AUDIT_LIMIT=50
OMNI_ALERT_CHECK_INTERVAL_MS=20000
OMNI_NO_DETECTION_ALERT_MS=180000
OMNI_CAMERA_INACTIVE_ALERT_MS=120000
OMNI_LATENCY_WARN_MS=500
OMNI_LOW_CONFIDENCE_THRESHOLD=0.55

# Frontend
VITE_BACKEND_URL=http://localhost:5000
VITE_OMNI_ROLE=admin
VITE_OMNI_USER=dashboard-operator
VITE_OMNI_API_KEY=change-admin-key
VITE_OMNI_SIGNING_ENABLED=true
VITE_OMNI_SIGNING_SECRET=replace-with-long-random-secret

# Optional prototype tuning
CAMERA_FRAME_INTERVAL_MS=180
MOCK_FRAME_INTERVAL_MS=600
DEMO_ACTIVE_STUDENT_ID=OC1001
